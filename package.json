{
	"name": "pi-safeguards",
	"version": "0.1.0",
	"description": "Path sandbox and shell emulation for pi, as a single extension: file tools stay inside the project, and bash runs through a pure-Node whitelist emulator instead of a real shell",
	"type": "module",
	"license": "MIT",
	"private": true,
	"pi": {
		"extensions": [
			"src/index.ts"
		]
	},
	"scripts": {
		"check": "biome check --write --error-on-warnings . && tsc --noEmit",
		"test": "vitest --run"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.84.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-ai": "0.84.4",
		"@types/node": "24.10.1",
		"typebox": "1.3.7",
		"typescript": "5.9.3",
		"vitest": "3.2.4"
	}
}
